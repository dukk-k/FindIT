<resources>
    <style name="Theme.FindIt" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.MyApplication" parent="Theme.FindIt"/>
    <style name="Theme.FindIt.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/teal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.FindIt</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
