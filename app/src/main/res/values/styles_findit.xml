<resources>
    <style name="TextBody">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextMeta" parent="TextBody">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="TextHeading" parent="TextBody">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Field">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:drawablePadding">10dp</item>
    </style>
    <style name="Action.Primary" parent="Action">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="Action">
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/deep_teal</item>
        <item name="android:background">@drawable/bg_outline</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>
    <style name="Action.Tab" parent="Action">
        <item name="android:background">@drawable/bg_tab_off</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">3dp</item>
        <item name="android:paddingEnd">3dp</item>
    </style>
</resources>
