<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
    </LinearLayout>
    <TextView
        android:id="@+id/secret"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextBody"
        android:background="@drawable/bg_notice"
        android:layout_marginBottom="12dp"
        android:padding="12dp"
        android:drawableStart="@drawable/ic_lock"
        android:drawablePadding="9dp"/>
    <LinearLayout
        android:id="@+id/claim_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
    </LinearLayout>
    <LinearLayout
        android:id="@+id/handover_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <EditText
            android:id="@+id/pickup_entry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Field"
            android:layout_marginBottom="8dp"
            android:hint="@string/ui_kode_dari_pemilik"
            android:inputType="textCapCharacters"
            android:maxLength="6"/>
        <android.widget.Button
            android:id="@+id/handover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Action.Primary"
            android:layout_marginBottom="8dp"
            android:text="@string/ui_konfirmasi_pengembalian"/>
    </LinearLayout>
</LinearLayout>
