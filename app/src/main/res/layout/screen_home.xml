<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" >
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:layout_marginBottom="8dp" android:gravity="center_vertical">
    <EditText android:id="@+id/search" style="@style/Field" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:layout_marginEnd="8dp" android:inputType="text" android:maxLength="120" android:singleLine="true" android:textSize="12sp"
    android:hint="@string/search" android:drawableStart="@drawable/ic_search" android:drawablePadding="5dp" android:imeOptions="actionSearch"/>
    <android.widget.Button android:id="@+id/filter" style="@style/Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/browse_filter" android:minWidth="0dp" android:textSize="12sp" android:textStyle="normal" android:drawableStart="@drawable/ic_filter" android:drawablePadding="2dp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:padding="4dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_segment">
<android.widget.Button android:id="@+id/all" style="@style/Action.Tab" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_semua" android:layout_weight="1" android:textSize="13sp"/>
<android.widget.Button android:id="@+id/lost" style="@style/Action.Tab" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_hilang" android:layout_weight="1" android:textSize="13sp"/>
<android.widget.Button android:id="@+id/found" style="@style/Action.Tab" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_ditemukan" android:layout_weight="1" android:textSize="13sp"/>
</LinearLayout>
<LinearLayout android:id="@+id/results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
</LinearLayout>
