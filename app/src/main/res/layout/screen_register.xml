<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" >
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="34dp" android:paddingEnd="34dp" android:paddingTop="18dp" android:paddingBottom="12dp">
    <EditText android:id="@+id/name" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:hint="@string/ui_nama_lengkap" android:inputType="textPersonName" android:drawableStart="@drawable/ic_person" android:autofillHints="name"/>
    <EditText android:id="@+id/email" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:hint="@string/email" android:inputType="textEmailAddress" android:drawableStart="@drawable/ic_mail" android:autofillHints="emailAddress"/>
    <EditText android:id="@+id/phone" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:hint="@string/ui_nomor_kontak" android:inputType="phone" android:drawableStart="@drawable/ic_phone" android:autofillHints="phone"/>
    <TextView style="@style/TextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp"
        android:text="@string/ui_nomor_kontak_hanya_dibagikan_ke_pengklaim_yang_klaimnya_anda_setujui"/>
    <EditText android:id="@+id/password" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:hint="@string/password" android:inputType="textPassword" android:drawableStart="@drawable/ic_lock" android:autofillHints="newPassword" android:saveEnabled="false"/>
    <EditText android:id="@+id/confirm" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:hint="@string/ui_ulangi_kata_sandi" android:inputType="textPassword" android:drawableStart="@drawable/ic_lock" android:saveEnabled="false"/>
    <android.widget.Button android:id="@+id/submit" style="@style/Action.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/register" android:layout_marginTop="16dp"/>
    <android.widget.Button android:id="@+id/switch_auth" style="@style/Action" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_sudah_punya_akun_masuk" android:background="@android:color/transparent" android:textColor="@color/ink" android:textSize="13sp"/>
</LinearLayout>
<ImageView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="210dp" android:layout_weight="1"
        android:src="@drawable/art_corner" android:scaleType="fitXY" android:importantForAccessibility="no"/>
</LinearLayout>
