<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:layout_marginBottom="8dp" android:gravity="center_vertical">
    <android.widget.Button android:id="@+id/report_search" style="@style/Action" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/search" android:layout_weight="1" android:layout_marginEnd="8dp" android:minWidth="0dp" android:textColor="@color/muted" android:textStyle="normal" android:gravity="start|center_vertical" android:textSize="12sp" android:drawableStart="@drawable/ic_search" android:drawablePadding="6dp" android:background="@drawable/bg_field"/>
    <android.widget.Button android:id="@+id/report_filter" style="@style/Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/browse_filter" android:minWidth="0dp" android:textSize="12sp" android:textStyle="normal" android:drawableStart="@drawable/ic_filter" android:drawablePadding="2dp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:padding="4dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_segment">
<android.widget.Button android:id="@+id/lost" style="@style/Action.Tab" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_hilang" android:layout_weight="1" android:textSize="13sp"/>
<android.widget.Button android:id="@+id/found" style="@style/Action.Tab" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_ditemukan" android:layout_weight="1" android:textSize="13sp"/>
</LinearLayout>
    <android.widget.Button
        android:id="@+id/photo"
        android:minHeight="106dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Action"
        android:layout_marginBottom="8dp"
        android:text="@string/report_photo"
        android:background="@drawable/bg_field"
        android:drawableStart="@drawable/ic_camera"
        android:drawablePadding="8dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextMeta"
        android:text="@string/ui_nama_barang"
        android:layout_marginBottom="3dp"/>
    <EditText
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Field"
        android:layout_marginBottom="8dp"
        android:hint="@string/ui_contoh_earbuds_nirkabel"
        android:inputType="textCapSentences"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextMeta"
                android:text="@string/ui_jenis"
                android:layout_marginBottom="3dp"/>
            <android.widget.Button
                android:id="@+id/category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Action"
                android:layout_marginBottom="8dp"
                android:text="@string/ui_pilih_kategori"
                android:background="@drawable/bg_field"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextMeta"
                android:text="@string/ui_warna"
                android:layout_marginBottom="3dp"/>
            <EditText
                android:id="@+id/color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Field"
                android:layout_marginBottom="8dp"
                android:hint="@string/ui_contoh_hitam"
                android:inputType="textCapSentences"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextMeta"
                android:text="@string/ui_lokasi"
                android:layout_marginBottom="3dp"/>
            <EditText
                android:id="@+id/location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Field"
                android:layout_marginBottom="8dp"
                android:hint="@string/ui_perpustakaan"
                android:inputType="textCapSentences"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextMeta"
                android:text="@string/ui_tanggal"
                android:layout_marginBottom="3dp"/>
            <android.widget.Button
                android:id="@+id/date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Action"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_field"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextMeta"
        android:text="@string/ui_deskripsi"
        android:layout_marginBottom="3dp"/>
    <EditText
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Field"
        android:layout_marginBottom="8dp"
        android:hint="@string/ui_tuliskan_deskripsi_umum"
        android:inputType="textCapSentences|textMultiLine"
        android:minLines="2"
        android:gravity="top"/>
    <LinearLayout
        android:id="@+id/secret_fields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_notice"
        android:padding="12dp"
        android:layout_marginBottom="9dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextHeading"
            android:text="@string/ui_informasi_rahasia"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="8dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextMeta"
            android:text="@string/ui_tidak_tampil_ke_publik_isi_ciri_unik_untuk_memeriksa_klaim"
            android:layout_marginVertical="5dp"/>
        <EditText
            android:id="@+id/brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Field"
            android:layout_marginBottom="8dp"
            android:hint="@string/ui_merek_barang"
            android:inputType="textCapSentences"/>
        <EditText
            android:id="@+id/markers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Field"
            android:layout_marginBottom="8dp"
            android:hint="@string/ui_ciri_khusus_misalnya_stiker_atau_goresan"
            android:inputType="textCapSentences"/>
    </LinearLayout>
    <android.widget.Button
        android:id="@+id/submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Action.Primary"
        android:layout_marginBottom="8dp"
        android:text="@string/ui_kirim_laporan"/>
</LinearLayout>
