<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/teal">
<FrameLayout android:layout_width="match_parent" android:layout_height="305dp">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/art_login_top" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <ImageView android:id="@+id/wordmark" android:layout_width="200dp" android:layout_height="108dp"
    android:layout_gravity="center" android:src="@drawable/ic_brand_light" android:scaleType="fitCenter" android:contentDescription="@string/app_name"/>
</FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="35dp" android:paddingEnd="35dp" android:paddingTop="38dp" android:paddingBottom="24dp"
    android:background="@drawable/bg_login_panel">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="33dp"
        android:text="@string/brand_login_heading" android:gravity="center" android:textColor="@color/teal"
        android:textSize="28sp" android:letterSpacing="-0.035" android:textStyle="bold"/>
    <EditText android:id="@+id/email" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:hint="@string/email" android:inputType="textEmailAddress" android:drawableStart="@drawable/ic_mail" android:autofillHints="emailAddress"/>
    <EditText android:id="@+id/password" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:hint="@string/password" android:inputType="textPassword" android:drawableStart="@drawable/ic_lock" android:autofillHints="password" android:saveEnabled="false"/>
    <android.widget.Button android:id="@+id/submit" style="@style/Action.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login" android:layout_marginTop="18dp"/>
    <android.widget.Button android:id="@+id/switch_auth" style="@style/Action" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_belum_punya_akun_daftar" android:background="@android:color/transparent" android:textColor="@color/ink" android:textSize="13sp"/>
</LinearLayout>
</LinearLayout>
