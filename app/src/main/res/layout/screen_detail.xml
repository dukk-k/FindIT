<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <ImageView
        android:id="@+id/item_photo"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:background="@drawable/bg_quiet"
        android:src="@drawable/ic_image"
        android:scaleType="center"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:layout_marginBottom="12dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/item_name"
            style="@style/TextHeading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:id="@+id/item_status"
            style="@style/TextMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="155dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/item_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextMeta"
        android:layout_marginBottom="12dp"/>
    <TextView
        android:id="@+id/detail_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextBody"
        android:background="@drawable/bg_notice"
        android:layout_marginBottom="12dp"
        android:padding="12dp"
        android:drawableStart="@drawable/ic_lock"
        android:drawablePadding="9dp"/>
    <LinearLayout
        android:id="@+id/detail_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
    </LinearLayout>
    <LinearLayout
        android:id="@+id/claim_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextHeading"
            android:text="@string/ui_ajukan_klaim"
            android:layout_marginBottom="6dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextMeta"
            android:text="@string/ui_ciri_ciri_yang_tidak_diketahui_publik"
            android:layout_marginBottom="3dp"/>
        <EditText
            android:id="@+id/proof"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Field"
            android:layout_marginBottom="8dp"
            android:hint="@string/proof_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3"
            android:gravity="top"/>
        <android.widget.Button
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Action"
            android:layout_marginBottom="8dp"
            android:text="@string/proof_photo"
            android:background="@drawable/bg_field"
            android:drawableStart="@drawable/ic_camera"/>
        <android.widget.Button
            android:id="@+id/submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Action.Primary"
            android:layout_marginBottom="8dp"
            android:text="@string/ui_kirim_klaim"/>
    </LinearLayout>
</LinearLayout>
