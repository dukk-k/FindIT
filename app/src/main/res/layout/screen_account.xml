<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">
        <ImageView
            android:id="@+id/avatar"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_avatar"
            android:src="@drawable/ic_person"
            android:scaleType="centerInside"
            android:padding="14dp"
            android:importantForAccessibility="no"
            android:layout_marginEnd="13dp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextHeading"/>
            <TextView
                android:id="@+id/contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextMeta"/>
        </LinearLayout>
    </LinearLayout>
    <android.widget.Button
        android:id="@+id/edit_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Action"
        android:layout_marginBottom="8dp"
        android:text="@string/ui_ubah_profil"
        android:gravity="center_vertical|start"
        android:drawableStart="@drawable/ic_person"
        android:drawableEnd="@drawable/ic_next"
        android:drawablePadding="10dp"
        android:background="@drawable/bg_card"
        android:textColor="@color/ink"/>
    <android.widget.Button
        android:id="@+id/change_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Action"
        android:layout_marginBottom="8dp"
        android:text="@string/ui_ubah_kata_sandi"
        android:gravity="center_vertical|start"
        android:drawableStart="@drawable/ic_lock"
        android:drawableEnd="@drawable/ic_next"
        android:drawablePadding="10dp"
        android:background="@drawable/bg_card"
        android:textColor="@color/ink"/>
    <android.widget.Button
        android:id="@+id/view_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Action"
        android:layout_marginBottom="8dp"
        android:text="@string/ui_riwayat_laporan_dan_klaim"
        android:gravity="center_vertical|start"
        android:drawableStart="@drawable/ic_clock"
        android:drawableEnd="@drawable/ic_next"
        android:drawablePadding="10dp"
        android:background="@drawable/bg_card"
        android:textColor="@color/ink"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextBody"
        android:text="@string/ui_informasi_rahasia_barang_dan_kode_pengambilan_hanya_terlihat_oleh_pihak_yang_berhak"
        android:background="@drawable/bg_tile"
        android:layout_marginBottom="12dp"
        android:padding="12dp"
        android:drawableStart="@drawable/ic_lock"
        android:drawablePadding="9dp"/>
    <android.widget.Button
        android:id="@+id/logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Action"
        android:layout_marginBottom="8dp"
        android:text="@string/ui_keluar"
        android:background="@drawable/bg_logout"
        android:textColor="@color/orange"/>
</LinearLayout>
