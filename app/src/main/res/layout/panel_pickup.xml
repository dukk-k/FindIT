<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_code"
    android:padding="13dp"
    android:layout_marginBottom="12dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextBody"
        android:text="@string/ui_kode_pengambilan"
        android:textStyle="bold"
        android:gravity="center"/>
    <TextView
        android:id="@+id/pickup_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextHeading"
        android:textSize="29sp"
        android:letterSpacing="0.08"
        android:gravity="center"
        android:layout_marginVertical="4dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextMeta"
        android:text="@string/ui_tunjukkan_kode_saat_bertemu_penemu_kode_hanya_berlaku_sekali"
        android:layout_marginVertical="8dp"/>
    <TextView
        android:id="@+id/finder_contact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextBody"/>
</LinearLayout>
